# ===== СИСТЕМА ЧАСТИНОК =====
particles = []


class Particle:
    def __init__(self, x, y, color, speed_mult=1.0, is_bubble=False):
        self.x, self.y = x, y
        self.vx = random.uniform(-4, 4) * speed_mult
        self.vy = random.uniform(-6, -1) * speed_mult
        self.color = color
        self.max_life = random.randint(15, 35)
        self.life = self.max_life
        self.is_bubble = is_bubble

    def update(self):
        self.x += self.vx
        self.y += self.vy
        if self.is_bubble:
            self.vy -= 0.15
            self.vx += math.sin(self.life * 0.4) * 0.5
        else:
            self.vy += 0.4
        self.life -= 1

    def draw(self):
        if self.life > 0:
            size = max(1, int(6 * (self.life / self.max_life)))
            pygame.draw.rect(screen, self.color, (self.x - camera_x, self.y - camera_y, size, size),
                             1 if self.is_bubble else 0)


def spawn_particles(x, y, color, count=10, speed=1.0, is_bubble=False):
    for _ in range(count):
        particles.append(Particle(x, y, color, speed, is_bubble))


