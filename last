cols, rows = 600, 200
world = []
# Матриця об'єму води: 0.0 - пусто, 1.0 - повна клітинка води
water_grid = [[0.0] * cols for _ in range(rows)]
heights = []
water_levels = [None] * cols


def get_biome_type(tx):
    if tx < 80:
        return "ocean"
    elif tx < 200:
        return "jungle"
    elif tx < 350:
        return "forest"
    elif tx < 450:
        return "crimson"
    elif tx < 530:
        return "desert"
    else:
        return "snow"


current_h = rows // 4
sea_level = rows // 4 + 4
in_lake = False
lake_width = 0
lake_level = 0

for x in range(cols):
    biome = get_biome_type(x)
    if biome == "ocean":
        in_lake = False
        if x > 65:
            current_h -= random.choice([0, 1, 2])
            current_h = max(sea_level - 2, current_h)
        else:
            current_h += random.choice([-1, 0, 1])
            current_h = min(sea_level + 35, max(sea_level + 10, current_h))
        heights.append(int(current_h))
        if current_h > sea_level: water_levels[x] = sea_level
    else:
        if in_lake:
            lake_width -= 1
            water_levels[x] = int(lake_level)
            if lake_width > 5:
                current_h += random.choice([0, 1, 1])
            elif lake_width > 0:
                current_h -= random.choice([0, 1, 1])
            else:
                in_lake = False; current_h = lake_level
            current_h = max(lake_level + 1, current_h)
        else:
            if x > 100 and random.random() < 0.04:
                in_lake = True
                lake_width = random.randint(8, 20)
                lake_level = current_h
                water_levels[x] = int(lake_level)
                current_h += 1
            else:
                if random.random() < 0.25: current_h += random.choice([-1, 1, 1, -1, 2, -2])
                current_h = max(10, min(rows // 3, current_h))
        heights.append(int(current_h))

for y in range(rows):
    row = []
    for x in range(cols):
        surface = heights[x]
        water_surface = water_levels[x]
        b_name = get_biome_type(x)

        if y == rows - 1:
            row.append("bedrock")
        elif water_surface is not None and water_surface <= y < surface:
            row.append("air")
            water_grid[y][x] = 1.0  # Заповнюємо водою як об'ємом
        elif y >= surface:
            is_cave = False
            if y > surface + 15:
                if math.sin(x * 0.2) + math.cos(y * 0.2) + random.uniform(-0.5, 0.5) > 0.8: is_cave = True

            if is_cave:
                row.append("air")
            elif y > surface + random.randint(10, 20):
                row.append("gold_ore" if random.random() < 0.02 else ("crimstone" if b_name == "crimson" else "stone"))
            else:
                if water_surface is not None and y == surface:
                    if b_name == "snow":
                        row.append("snow")
                    elif b_name == "jungle":
                        row.append("mud")
                    elif b_name == "crimson":
                        row.append("crimson_dirt")
                    elif b_name in ["desert", "ocean"]:
                        row.append("sand")
                    else:
                        row.append("dirt")
                else:
                    if b_name == "snow":
                        row.append("ice" if y > surface else "snow")
                    elif b_name in ["desert", "ocean"]:
                        row.append("sand")
                    elif b_name == "jungle":
                        row.append("mud" if y > surface else "jungle_grass")
                    elif b_name == "crimson":
                        row.append("crimson_dirt" if y > surface else "crimson_grass")
                    else:
                        row.append("dirt" if y > surface else "grass")
        else:
            row.append("air")
    world.append(row)

for _ in range(40):
