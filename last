player = Player()
enemies = []
fishes = []
camera_x, camera_y = 0, 0

current_biome_str = "Forest"
biome_fade_alpha = 255
BIOME_COLORS = {
    "ocean": (50, 150, 255), "jungle": (100, 180, 100), "forest": (135, 206, 235),
    "crimson": (150, 60, 60), "desert": (255, 200, 100), "snow": (200, 230, 255)
}
current_sky_color = list(BIOME_COLORS["forest"])


def get_biome_display_name(x, y):
    if y > heights[max(0, min(cols - 1, int(x // TILE)))] * TILE + 600: return "Underground", "underground"
    tx = max(0, min(cols - 1, int(x // TILE)))
    b_id = get_biome_type(tx)
    names = {"ocean": "The Ocean", "jungle": "Deep Jungle", "forest": "Lush Forest",
             "crimson": "The Crimson", "desert": "Scorching Desert", "snow": "Frozen Tundra"}
    return names[b_id], b_id


# ===== ОПТИМІЗОВАНА ФІЗИКА СУТНОСТЕЙ =====
def move(e):
    e.x += e.vel_x
    e.x = max(0, min(e.x, cols * TILE - e.w))

    mx, M_x = max(0, int(e.x // TILE) - 1), min(cols - 1, int((e.x + e.w) // TILE) + 1)
    my, M_y = max(0, int(e.y // TILE) - 1), min(rows - 1, int((e.y + e.h) // TILE) + 1)

    for y in range(my, M_y + 1):
        for x in range(mx, M_x + 1):
            if world[y][x] != "air":
                if e.x < (x + 1) * TILE and e.x + e.w > x * TILE and e.y < (y + 1) * TILE and e.y + e.h > y * TILE:
                    if e.vel_x > 0:
                        e.x = x * TILE - e.w
                    elif e.vel_x < 0:
                        e.x = (x + 1) * TILE

    cx, cy = int((e.x + e.w / 2) // TILE), int((e.y + e.h / 2) // TILE)
    in_water = (0 <= cx < cols and 0 <= cy < rows and water_grid[cy][cx] > 0.3)

    if in_water:
        e.vel_y += 0.15
        if e.vel_y > 3: e.vel_y = 3
    else:
        e.vel_y += 0.5
        if e.vel_y > 15: e.vel_y = 15

    e.y += e.vel_y
    e.on_ground = False

    mx, M_x = max(0, int(e.x // TILE) - 1), min(cols - 1, int((e.x + e.w) // TILE) + 1)
    my, M_y = max(0, int(e.y // TILE) - 1), min(rows - 1, int((e.y + e.h) // TILE) + 1)

    for y in range(my, M_y + 1):
        for x in range(mx, M_x + 1):
            if world[y][x] != "air":
                if e.x < (x + 1) * TILE and e.x + e.w > x * TILE and e.y < (y + 1) * TILE and e.y + e.h > y * TILE:
                    if e.vel_y > 0:
                        e.y = y * TILE - e.h
                        e.vel_y = 0
                        e.on_ground = True
                    elif e.vel_y < 0:
                        e.y = (y + 1) * TILE
                        e.vel_y = 0


# ===== ШРИФТИ ТА ПОВЕРХНІ =====
big_font = pygame.font.SysFont("Impact", 60)
font = pygame.font.SysFont(None, 24)
biome_txt_surf = big_font.render(current_biome_str, True, (255, 255, 255))

underwater_overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
text_cache = {}


def get_cached_text(text, font_obj, color):
    key = (text, id(font_obj), color)
    if key not in text_cache:
        text_cache[key] = font_obj.render(text, True, color)
    return text_cache[key]


water_timer = 0
frame_count = 0

while True:
    frame_count += 1
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()
        if event.type == pygame.KEYDOWN:
            if pygame.K_1 <= event.key <= pygame.K_6:
                player.sel_idx = event.key - pygame.K_1

    if player.action_cd > 0: player.action_cd -= 1

    mouse_x, mouse_y = pygame.mouse.get_pos()
    click = pygame.mouse.get_pressed()
    wx, wy = mouse_x + camera_x, mouse_y + camera_y
    tx, ty = int(wx // TILE), int(wy // TILE)
    sel_item = player.hotbar[player.sel_idx]

    dist = math.hypot(wx - (player.x + player.w / 2), wy - (player.y + player.h / 2))
    in_reach = dist <= player.reach
    valid_tile = 0 <= tx < cols and 0 <= ty < rows

    if player.action_cd == 0:
        if click[0]:
            if sel_item == "pickaxe" and valid_tile and in_reach:
                target = world[ty][tx]
                if target not in ["air", "bedrock"]:
                    if target == "chest":
                        player.inventory["magic_sword"] = 1
                        if "magic_sword" not in player.hotbar: player.hotbar.insert(1, "magic_sword")
                        player.inventory["gold_ore"] = player.inventory.get("gold_ore", 0) + 5
                        spawn_particles(wx, wy, (255, 215, 0), 20, 2.0)
                    else:
                        player.inventory[target] = player.inventory.get(target, 0) + 1
                        spawn_particles(wx, wy, BLOCK_COLORS.get(target, (150, 150, 150)), 8)

                    world[ty][tx] = "air"
                    player.action_cd = 12

            elif sel_item in ["sword", "magic_sword"]:
                player.action_cd = 10 if sel_item == "magic_sword" else 20
                hx = player.x + (20 if player.facing_right else -40)
                hy = player.y

                for e in enemies[:]:
                    if hx < e.x + e.w and hx + 40 > e.x and hy < e.y + e.h and hy + 40 > e.y:
                        e.hp -= 20 if sel_item == "magic_sword" else 10
                        e.vel_x, e.vel_y = (8 if player.facing_right else -8), -5
                        spawn_particles(e.x + e.w / 2, e.y + e.h / 2, (200, 0, 0), 10)
                        if e.hp <= 0: enemies.remove(e)

                for f in fishes[:]:
                    if hx < f.x + f.w and hx + 40 > f.x and hy < f.y + f.h and hy + 40 > f.y:
                        f.hp -= 20 if sel_item == "magic_sword" else 10
                        spawn_particles(f.x + f.w / 2, f.y + f.h / 2, (200, 0, 0), 5)
                        if f.hp <= 0: fishes.remove(f)

        elif click[2] and sel_item not in ["sword", "pickaxe", "magic_sword"]:
            if valid_tile and in_reach and player.inventory.get(sel_item, 0) > 0:
                if world[ty][tx] == "air" and water_grid[ty][tx] < 0.5:
                    if not (tx * TILE < player.x + player.w and (
                            tx + 1) * TILE > player.x and ty * TILE < player.y + player.h and (
                                    ty + 1) * TILE > player.y):
                        world[ty][tx] = sel_item
                        player.inventory[sel_item] -= 1
                        player.action_cd = 10

    keys = pygame.key.get_pressed()
    player.vel_x = 0

    px = int((player.x + player.w / 2) // TILE)
    py_feet = int((player.y + player.h - 5) // TILE)
    py_head = int((player.y + 5) // TILE)

    in_water_feet = (0 <= px < cols and 0 <= py_feet < rows and water_grid[py_feet][px] > 0.3)
    in_water_head = (0 <= px < cols and 0 <= py_head < rows and water_grid[py_head][px] > 0.7)

    water_color_here = BLOCK_COLORS["water"]

    speed = 3 if in_water_feet else 6
    if keys[pygame.K_a]:
        player.vel_x = -speed
        player.facing_right = False
    elif keys[pygame.K_d]:
        player.vel_x = speed
        player.facing_right = True

    if keys[pygame.K_w] or keys[pygame.K_SPACE]:
        if in_water_feet:
            if not in_water_head:
                player.vel_y = -8
            else:
                player.vel_y -= 0.4
                if player.vel_y < -4: player.vel_y = -4
                if random.random() < 0.2: spawn_particles(player.x + player.w / 2, player.y + player.h,
                                                          water_color_here, 1, 0.5, is_bubble=True)
        elif player.on_ground:
            player.vel_y = -10

    if in_water_feet and random.randint(1, 8) == 1:
        bx, by = player.x + random.randint(-400, 400), player.y + random.randint(0, 300)
        stx, sty = int(bx // TILE), int(by // TILE)
        if 0 <= stx < cols and 0 <= sty < rows and water_grid[sty][stx] > 0.3:
            spawn_particles(bx, by, water_color_here, 1, 0.5, is_bubble=True)

    for e in enemies[:]:
        e.hp -= 0.04
        if e.hp <= 0: enemies.remove(e)

    move(player)

    if random.randint(1, 100) == 1 and len(enemies) < 8:
        spawn_x = player.x + random.choice([-500, 500])
        if 0 < spawn_x < cols * TILE: enemies.append(Enemy(spawn_x, 0, get_biome_type(int(spawn_x // TILE))))

    if random.randint(1, 60) == 1 and len(fishes) < 15:
        spawn_x, spawn_y = player.x + random.randint(-800, 800), player.y + random.randint(-600, 600)
        stx, sty = int(spawn_x // TILE), int(spawn_y // TILE)
        if 0 <= stx < cols and 0 <= sty < rows and water_grid[sty][stx] > 0.3:
            fishes.append(Fish(spawn_x, spawn_y, get_biome_type(stx)))

    for e in enemies:
        if e.x < player.x - 10:
            e.vel_x = 1.5
        elif e.x > player.x + 10:
            e.vel_x = -1.5
        else:
            e.vel_x = 0

        if e.vel_x != 0 and e.on_ground:
            fx = int((e.x + (TILE if e.vel_x > 0 else -5)) // TILE)
            if 0 <= fx < cols and world[int(e.y // TILE)][fx] != "air":
                e.vel_y = -9
        move(e)
        if e.x < player.x + player.w and e.x + e.w > player.x and e.y < player.y + player.h and e.y + e.h > player.y:
            player.hp -= 0.5

    time_ticks = pygame.time.get_ticks()

    for f in fishes[:]:
        f.x += f.vel_x
        f.y += math.sin(time_ticks * 0.005 + f.x) * 0.5
        fx_center, fy_center = int((f.x + f.w / 2) // TILE), int((f.y + f.h / 2) // TILE)
        if not (0 <= fx_center < cols and 0 <= fy_center < rows and water_grid[fy_center][fx_center] > 0.2):
            f.vel_x *= -1
            f.x += f.vel_x * 2
        if f.is_aggressive and f.x < player.x + player.w and f.x + f.w > player.x and f.y < player.y + player.h and f.y + f.h > player.y:
            player.hp -= 0.5

    camera_x += ((player.x - WIDTH // 2) - camera_x) * 0.1
    camera_y += ((player.y - HEIGHT // 2) - camera_y) * 0.1
    camera_x = max(0, min(camera_x, cols * TILE - WIDTH))
    camera_y = max(0, min(camera_y, rows * TILE - HEIGHT))

    b_name, b_id = get_biome_display_name(player.x, player.y)
    if b_name != current_biome_str:
        current_biome_str, biome_fade_alpha = b_name, 255
        biome_txt_surf = big_font.render(current_biome_str, True, (255, 255, 255))

    target_c = BIOME_COLORS.get(b_id, (30, 20, 20))
    current_sky_color[0] += (target_c[0] - current_sky_color[0]) * 0.05
    current_sky_color[1] += (target_c[1] - current_sky_color[1]) * 0.05
    current_sky_color[2] += (target_c[2] - current_sky_color[2]) * 0.05

    # ===== ГІДРОДИНАМІКА КЛІТИННОГО ОБ'ЄМУ (ЯК У TERRARIA) =====
    water_timer += 1
    if water_timer >= 2:
        water_timer = 0

        sx = max(0, int(camera_x // TILE) - 5)
        ex = min(cols - 2, int((camera_x + WIDTH) // TILE) + 5)
        sy = max(0, int(camera_y // TILE) - 5)
        ey = min(rows - 2, int((camera_y + HEIGHT) // TILE) + 5)

        # Створюємо буфер для безпечного паралельного перерахунку
        new_water = [row[:] for row in water_grid]

        for y in range(ey, sy - 1, -1):
            for x in range(sx, ex + 1):
                mass = water_grid[y][x]
                if mass <= 0.005: continue
                if world[y][x] != "air":
                    new_water[y][x] = 0.0
                    continue

                # 1. Стік вниз
                if world[y + 1][x] == "air":
                    current_down = water_grid[y + 1][x]
                    # Скільки може вмістити нижня клітинка
                    flow = min(mass, 1.0 - current_down)
                    if flow > 0:
                        new_water[y][x] -= flow
                        new_water[y + 1][x] += flow
                        mass -= flow

                if mass <= 0.005: continue

                # 2. Розтікання вбоки (Принцип сполучених посудин)
                # Перевіряємо ліву та праву клітинки
                left_open = (x > 0 and world[y][x - 1] == "air")
                right_open = (x < cols - 1 and world[y][x + 1] == "air")

                if left_open and right_open:
                    # Рахуємо середній рівень між трьома клітинками
                    total = mass + water_grid[y][x - 1] + water_grid[y][x + 1]
                    avg = total / 3.0

                    # Переливаємо вліво
                    if water_grid[y][x - 1] < avg:
                        flow_l = min(mass, avg - water_grid[y][x - 1])
                        new_water[y][x] -= flow_l
                        new_water[y][x - 1] += flow_l
                        mass -= flow_l
                    # Переливаємо вправо
                    if water_grid[y][x + 1] < avg and mass > 0:
                        flow_r = min(mass, avg - water_grid[y][x + 1])
                        new_water[y][x] -= flow_r
                        new_water[y][x + 1] += flow_r
                elif left_open:
                    total = mass + water_grid[y][x - 1]
                    avg = total / 2.0
                    if water_grid[y][x - 1] < avg:
                        flow = min(mass, avg - water_grid[y][x - 1])
                        new_water[y][x] -= flow
                        new_water[y][x - 1] += flow
                elif right_open:
                    total = mass + water_grid[y][x + 1]
                    avg = total / 2.0
                    if water_grid[y][x + 1] < avg:
                        flow = min(mass, avg - water_grid[y][x + 1])
                        new_water[y][x] -= flow
                        new_water[y][x + 1] += flow

        # Застосовуємо прорахований буфер об'ємів
        water_grid = new_water

    # --- РЕНДЕР ---
    screen.fill((int(current_sky_color[0]), int(current_sky_color[1]), int(current_sky_color[2])))

    sx, ex = max(0, int(camera_x // TILE)), min(cols, int((camera_x + WIDTH) // TILE) + 1)
    sy, ey = max(0, int(camera_y // TILE)), min(rows, int((camera_y + HEIGHT) // TILE) + 1)

    for y in range(sy, ey):
        for x in range(sx, ex):
            block = world[y][x]
            w_mass = water_grid[y][x]

            if block != "air":
                screen.blit(TEXTURES.get(block, TEXTURES["dirt"]), (x * TILE - camera_x, y * TILE - camera_y))
            elif w_mass > 0.1:  # Візуальний поріг відсікання мікро-крапель
                is_surface = (y == 0 or water_grid[y - 1][x] <= 0.1)
                if is_surface:
                    # Хвиля плавно підлаштовується під реальний об'єм заповнення клітинки
                    base_h = int(TILE * min(1.0, w_mass))
                    wave_offset = int(math.sin(time_ticks * 0.003 + x * 0.5) * 3)
                    final_h = max(2, min(TILE, base_h + wave_offset))

                    screen.blit(TEXTURES["water"],
                                (x * TILE - camera_x, y * TILE - camera_y + (TILE - final_h)),
                                (0, 0, TILE, final_h))
                else:
                    screen.blit(TEXTURES["water"], (x * TILE - camera_x, y * TILE - camera_y))

    if valid_tile and in_reach:
        pygame.draw.rect(screen, (255, 255, 255), (tx * TILE - camera_x, ty * TILE - camera_y, TILE, TILE), 2)

    for p in particles:
        p.update()
        p.draw()
    particles = [p for p in particles if p.life > 0]

    for f in fishes:
        pygame.draw.rect(screen, f.color, (f.x - camera_x, f.y - camera_y, f.w, f.h))
        pygame.draw.rect(screen, (0, 0, 0), (f.x - camera_x, f.y - camera_y, f.w, f.h), 1)
        pygame.draw.rect(screen, (0, 0, 0),
                         (f.x - camera_x + (f.w - 4 if f.vel_x > 0 else 2), f.y - camera_y + 2, 2, 2))

    for e in enemies:
        pygame.draw.rect(screen, e.color, (e.x - camera_x, e.y - camera_y, e.w, e.h))
        pygame.draw.rect(screen, (0, 0, 0), (e.x - camera_x, e.y - camera_y, e.w, e.h), 2)
        pygame.draw.rect(screen, (255, 0, 0), (e.x - camera_x, e.y - camera_y - 10, e.w * (e.hp / 30), 4))

    pygame.draw.rect(screen, (50, 50, 255), (player.x - camera_x, player.y - camera_y, player.w, player.h))

    if sel_item in ICONS_SCALE:
        off_y = 15 if player.action_cd > 0 else 0
        if player.facing_right:
            screen.blit(ICONS_SCALE[sel_item], (player.x - camera_x + 10, player.y - camera_y + off_y))
        else:
            screen.blit(ICONS_FLIPPED[sel_item], (player.x - camera_x - 20, player.y - camera_y + off_y))

    if in_water_head:
        underwater_overlay.fill((0, 100, 200, 70))
        screen.blit(underwater_overlay, (0, 0))

    for i, item in enumerate(player.hotbar):
        r = pygame.Rect(10 + i * 50, 10, 46, 46)
        pygame.draw.rect(screen, (50, 50, 50, 150), r)
        if i == player.sel_idx: pygame.draw.rect(screen, (255, 215, 0), r, 3)

        if item in ICONS_SCALE:
            screen.blit(ICONS_SCALE[item], (13 + i * 50, 13))
        elif item in TEXTURES:
            screen.blit(TEXTURES[item], (17 + i * 50, 17))
            inv_count = str(player.inventory.get(item, 0))
            screen.blit(get_cached_text(inv_count, font, (0, 0, 0)), (16 + i * 50, 36))
            screen.blit(get_cached_text(inv_count, font, (255, 255, 255)), (15 + i * 50, 35))

    pygame.draw.rect(screen, (255, 0, 0), (WIDTH - 220, 20, max(0, player.hp) * 2, 20))
    pygame.draw.rect(screen, (255, 255, 255), (WIDTH - 220, 20, 200, 20), 2)
    screen.blit(get_cached_text(f"HP: {int(player.hp)}", font, (255, 255, 255)), (WIDTH - 150, 22))

    if biome_fade_alpha > 0:
        biome_fade_alpha -= 2
        biome_txt_surf.set_alpha(biome_fade_alpha)
        screen.blit(biome_txt_surf, (WIDTH // 2 - biome_txt_surf.get_width() // 2, HEIGHT // 4))

    pygame.display.flip()
    clock.tick(60)
