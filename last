# ===== ПРОЦЕДУРНІ ТЕКСТУРИ =====
def make_tex(base_color, variance=15, border=True, pattern=None):
    surf = pygame.Surface((TILE, TILE))
    for y in range(TILE):
        for x in range(TILE):
            r = max(0, min(255, base_color[0] + random.randint(-variance, variance)))
            g = max(0, min(255, base_color[1] + random.randint(-variance, variance)))
            b = max(0, min(255, base_color[2] + random.randint(-variance, variance)))
            surf.set_at((x, y), (r, g, b))

    if pattern == "ore":
        for _ in range(6):
            pygame.draw.rect(surf, (255, 215, 0), (random.randint(0, TILE - 5), random.randint(0, TILE - 5), 4, 4))
    elif pattern == "water":
        surf.set_alpha(160)
        return surf.convert()
    elif pattern == "chest":
        pygame.draw.rect(surf, (139, 69, 19), (2, 2, TILE - 4, TILE - 4))
        pygame.draw.rect(surf, (169, 169, 169), (0, 8, TILE, 4))
        pygame.draw.rect(surf, (255, 215, 0), (TILE // 2 - 3, 8, 6, 8))

    if border:
        pygame.draw.rect(surf, (max(0, base_color[0] - 40), max(0, base_color[1] - 40), max(0, base_color[2] - 40)),
                         (0, 0, TILE, TILE), 1)
    return surf.convert()


def make_icon(item_type):
    surf = pygame.Surface((32, 32), pygame.SRCALPHA)
    if item_type == "sword":
        pygame.draw.line(surf, (150, 150, 150), (4, 28), (28, 4), 6)
        pygame.draw.line(surf, (139, 69, 19), (4, 28), (10, 22), 6)
    elif item_type == "magic_sword":
        pygame.draw.line(surf, (0, 255, 255), (4, 28), (28, 4), 8)
    elif item_type == "pickaxe":
        pygame.draw.line(surf, (139, 69, 19), (4, 28), (24, 8), 4)
        pygame.draw.arc(surf, (150, 150, 150), (8, 0, 24, 24), 0, 3.14, 5)
    return surf.convert_alpha()


